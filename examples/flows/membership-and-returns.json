{
  "schema_version": 2,
  "tool_exposure": "gateway",
  "always_tools": ["contact_support", "request_recall", "end_call"],
  "always_action_policies": [
    { "tool": "contact_support", "max_calls": 1, "idempotency": "per_call" },
    { "tool": "request_recall", "max_calls": 3, "idempotency": "per_call_arguments" },
    { "tool": "end_call", "max_calls": 1, "idempotency": "per_call" }
  ],
  "nodes": [
    {
      "id": "entry",
      "label": "Incoming call",
      "kind": "incoming_call"
    },
    {
      "id": "membership",
      "label": "Membership",
      "kind": "topic",
      "context": "Answer membership questions and perform account changes only after verification.",
      "steps": [
        {
          "id": "verify",
          "label": "Verify member",
          "instructions": "Collect the member number and one approved verification factor. Never expose account details before the lookup succeeds.",
          "tools": ["read_table"],
          "required_outputs": ["member_id"],
          "output_bindings": [
            { "output": "member_id", "tool": "read_table", "result_path": "rows.0.id", "value_type": "string" }
          ],
          "action_policies": [
            { "tool": "read_table", "max_calls": 3, "idempotency": "per_arguments" }
          ],
          "success_criteria": ["The member record matches the caller", "No sensitive value was spoken back unnecessarily"],
          "checkpoint": true,
          "max_attempts": 3,
          "on_failure": "membership.escalate",
          "steps": [
            {
              "id": "details",
              "label": "Explain membership",
              "instructions": "Answer only from the verified member row and company knowledge. Offer the relevant next action.",
              "tools": ["search_knowledge"]
            },
            {
              "id": "renew",
              "label": "Renew membership",
              "instructions": "Confirm term, price, and consent, then renew exactly once using the verified member_id.",
              "tools": ["renew_membership"],
              "required_outputs": ["renewal_id", "expires_at"],
              "output_bindings": [
                { "output": "renewal_id", "tool": "renew_membership", "result_path": "renewal_id", "value_type": "string" },
                { "output": "expires_at", "tool": "renew_membership", "result_path": "expires_at", "value_type": "string" }
              ],
              "action_policies": [
                { "tool": "renew_membership", "max_calls": 1, "idempotency": "per_step" }
              ],
              "transitions": [
                {
                  "to": "membership.confirm",
                  "when": "renewal_id was returned",
                  "label": "Renewed",
                  "condition": {
                    "output": "renewal_id",
                    "operator": "exists"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "confirm",
          "label": "Confirm result",
          "instructions": "Read back the new expiration date and offer a receipt.",
          "tools": ["send_email"],
          "required_outputs": ["confirmation_delivered"],
          "output_bindings": [
            { "output": "confirmation_delivered", "tool": "send_email", "result_path": "ok", "value_type": "boolean" }
          ],
          "action_policies": [
            { "tool": "send_email", "max_calls": 1, "idempotency": "per_arguments" }
          ]
        },
        {
          "id": "escalate",
          "label": "Verification failed",
          "instructions": "Do not reveal account data. Offer human support or a callback."
        }
      ]
    },
    {
      "id": "returns",
      "label": "Return an order",
      "kind": "topic",
      "context": "Locate an order, evaluate policy, and create a return without skipping consent or durable recording.",
      "steps": [
        {
          "id": "locate",
          "label": "Locate order",
          "instructions": "Collect the order number and match it to the caller.",
          "tools": ["read_table"],
          "required_outputs": ["order_id"],
          "output_bindings": [
            { "output": "order_id", "tool": "read_table", "result_path": "rows.0.id", "value_type": "string" }
          ],
          "action_policies": [
            { "tool": "read_table", "max_calls": 3, "idempotency": "per_arguments" }
          ],
          "checkpoint": true,
          "steps": [
            {
              "id": "eligibility",
              "label": "Check eligibility",
              "instructions": "Evaluate the return window, item condition, and policy exceptions. Do not promise a refund before this finishes.",
              "tools": ["search_knowledge", "check_return_eligibility"],
              "required_outputs": ["eligible", "reason"],
              "output_bindings": [
                { "output": "eligible", "tool": "check_return_eligibility", "result_path": "eligible", "value_type": "boolean" },
                { "output": "reason", "tool": "check_return_eligibility", "result_path": "reason", "value_type": "string" }
              ],
              "action_policies": [
                { "tool": "check_return_eligibility", "max_calls": 2, "idempotency": "per_arguments" }
              ],
              "steps": [
                {
                  "id": "create",
                  "label": "Create return",
                  "instructions": "Confirm the return method and create the return exactly once.",
                  "tools": ["create_return", "send_email"],
                  "required_outputs": ["return_id", "label_delivered"],
                  "output_bindings": [
                    { "output": "return_id", "tool": "create_return", "result_path": "return_id", "value_type": "string" },
                    { "output": "label_delivered", "tool": "send_email", "result_path": "ok", "value_type": "boolean" }
                  ],
                  "action_policies": [
                    { "tool": "create_return", "max_calls": 1, "idempotency": "per_step" },
                    { "tool": "send_email", "max_calls": 1, "idempotency": "per_arguments" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "other",
      "label": "Something else",
      "kind": "fallback",
      "context": "The request is outside configured workflows. Do not improvise policy.",
      "support_number": "+15550000000"
    }
  ],
  "edges": [
    { "from": "entry", "to": "membership", "label": "Membership" },
    { "from": "entry", "to": "returns", "label": "Returns" },
    { "from": "entry", "to": "other", "label": "Other" }
  ]
}
