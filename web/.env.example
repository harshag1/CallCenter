# App
NEXT_PUBLIC_APP_NAME=Voice Agent Studio
PUBLIC_ORIGIN=http://localhost:3000

# Database (local Docker Compose defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_agents
DATABASE_SSL=disable
# Supabase alternative:
# SUPABASE_DB_URL=postgresql://...
# DATABASE_SSL=verify-full
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Generate independent values; never reuse these.
# openssl rand -hex 32
AUTH_CODE_HMAC_SECRET=
MCP_GATEWAY_SECRET=
# Exactly 64 hex characters: openssl rand -hex 32
ENV_VAULT_MASTER_KEY=

# Realtime voice — configure at least one provider.
XAI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Required only for native xAI SIP webhooks in production.
XAI_SIP_SIGNING_SECRET=

# Email login and agent email. In development, missing RESEND_API_KEY prints OTPs to the terminal.
RESEND_API_KEY=
EMAIL_FROM=Voice Agent Studio <voice@example.com>

# Twilio PSTN/SMS (optional for browser-only voice agents)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Alternative Twilio auth; use this pair only when it belongs to TWILIO_ACCOUNT_SID.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
BRIDGE_WS_URL=ws://localhost:8080/stream

# Operator/builder model. The current builder loop uses xAI chat.
# XAI_API_KEY above enables it.

# Optional isolated Vercel tool factory. Disabled by default for safety.
ENABLE_TOOL_FACTORY=false
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TOOLS_PROJECT=voice-agent-tools

# Scheduler
CRON_SECRET=
