# App
NEXT_PUBLIC_APP_NAME=Harsha's Amazing Call Center
PUBLIC_ORIGIN=http://localhost:3000

# Database (local Docker Compose defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_agents
# Production: use a distinct non-owner LOGIN that inherits only hacc_backend.
DATABASE_RUNTIME_ROLE=hacc_runtime
# Set true outside production when you want startup to enforce the same role audit.
DATABASE_ENFORCE_LEAST_PRIVILEGE=false
# Required for production migrations. This must be a separate DDL owner URL;
# never point it at hacc_runtime or hacc_worker_runtime.
MIGRATION_DATABASE_URL=
# Plaintext is accepted only for this non-production loopback URL. Production
# and remote hosts default to verify-full. Do not add sslmode/ssl/cert/key query
# parameters to a database URL; DATABASE_SSL is the only TLS policy input.
DATABASE_SSL=disable
# Supabase alternative:
# SUPABASE_DB_URL=postgresql://...
# DATABASE_SSL=verify-full
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Generate independent values; never reuse these.
# openssl rand -hex 32
AUTH_CODE_HMAC_SECRET=
# Anonymous email OTP delivery fails closed unless the request source comes from
# a trusted edge. Vercel uses its sanitized x-vercel-forwarded-for automatically.
# Self-hosted deployments must name the header their proxy overwrites. Allowed:
# cf-connecting-ip, x-forwarded-for, x-real-ip, x-vercel-forwarded-for.
# Never select a client-spoofable forwarding header.
AUTH_TRUSTED_CLIENT_IP_HEADER=
MCP_GATEWAY_SECRET=
CAMPAIGN_COMMITMENT_SECRET=
# Exactly 64 hex characters: openssl rand -hex 32
ENV_VAULT_MASTER_KEY=

# Realtime voice — configure at least one provider.
XAI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Required only for native xAI SIP webhooks in production.
XAI_SIP_SIGNING_SECRET=

# External MCP production egress gate. Both are required in production.
# Exact comma-separated hostnames only; no wildcards, schemes, paths, or credentials.
MCP_EGRESS_ALLOWED_HOSTS=
# Operator/deployment assertion only: set this exact value only after the deployment network
# blocks private, link-local, and cloud-metadata destinations after DNS resolution.
# This does not itself eliminate DNS rebinding; see docs/extending-tools.md.
MCP_EGRESS_NETWORK_GUARD=

# Email login and agent email. Missing provider credentials fail closed by default.
RESEND_API_KEY=
EMAIL_FROM=Harsha's Amazing Call Center <voice@example.com>
# Explicit local-only debugging opt-in. Production ignores this setting.
ALLOW_DEV_OTP_STDOUT=false
# Resend API acceptance is not inbox delivery; no delivery-webhook integration is bundled.

# Twilio PSTN/SMS (optional for browser-only voice agents)
TWILIO_ACCOUNT_SID=
# Inbound webhook and Media Stream signature verification only. Never used for REST calls.
TWILIO_AUTH_TOKEN=
# Outbound REST access requires a least-privilege Restricted API key for this account.
# Grant only the Voice/Messaging/Verify/Numbers operations your deployment enables.
TWILIO_API_KEY_TYPE=restricted
TWILIO_API_KEY_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
# Must exactly match the standalone bridge's canonical public /stream URL.
BRIDGE_WS_URL=wss://bridge.example.com/stream
# Independent HMAC key for internal accepted/delivered receipt bindings (openssl rand -base64 48).
TELEPHONY_RECEIPT_SECRET=
# Browser recordings only. Integer 1-365; callers may request a shorter period.
CALL_RECORDING_RETENTION_DAYS=30

# Operator/builder model. The current builder loop uses xAI chat.
# Production browser and builder routes never spend deployment provider keys:
# the project does not yet ship tenant-scoped BYOK or a truthful durable budget
# authority for these calls. Explicit opt-in is accepted only outside production
# with an http://localhost, http://127.0.0.1, or http://[::1] PUBLIC_ORIGIN, for
# a developer spending their own key on their own machine.
ALLOW_DEV_DEPLOYMENT_FUNDED_AI=false

# Optional network egress is fail-closed in production. Enabling a capability
# requires both the global acknowledgement and its exact capability flag.
# These switches are not spend authority, BYOK, destination trust, or model approval.
HACC_ENABLE_EXTERNAL_EGRESS=false
HACC_ENABLE_OPERATOR_JS_EGRESS=false
HACC_ENABLE_OPERATOR_WEB_SEARCH_EGRESS=false
HACC_ENABLE_GENERATED_TOOL_DEPLOYMENT_EGRESS=false
HACC_ENABLE_GENERATED_TOOL_INVOCATION_EGRESS=false

# Optional isolated Vercel tool factory. Disabled by default for safety.
# create_tool is not model-callable until a funded-approval adapter exists.
ENABLE_TOOL_FACTORY=false
# Exact review digests only. Generated code can return/transmit any granted env value.
GENERATED_TOOL_SECRET_APPROVALS=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TOOLS_PROJECT=voice-agent-tools

# Optional external JavaScript isolation service for the builder's run_js tool.
# No sandbox is bundled; when either value is absent, run_js is not exposed.
OPERATOR_JS_SANDBOX_URL=
OPERATOR_JS_SANDBOX_TOKEN=

# Scheduler
# At least 32 opaque characters; for example: openssl rand -hex 32
CRON_SECRET=
