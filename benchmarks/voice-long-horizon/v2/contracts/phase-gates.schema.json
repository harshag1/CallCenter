{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hacc.dev/schemas/proof-v1/phase-gates.schema.json",
  "title": "HACC-Proof-v1 phase gates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "example_only", "serial", "stop_on_failed_or_ambiguous", "phases"],
  "properties": {
    "schema_version": { "const": 1 },
    "protocol_id": { "const": "hacc-proof-v1" },
    "example_only": { "type": "boolean" },
    "serial": { "const": true },
    "stop_on_failed_or_ambiguous": { "const": true },
    "phases": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        { "$ref": "#/$defs/P0" }, { "$ref": "#/$defs/P1" }, { "$ref": "#/$defs/P2" },
        { "$ref": "#/$defs/P3" }, { "$ref": "#/$defs/P4" }, { "$ref": "#/$defs/P5" }, { "$ref": "#/$defs/P6" }
      ],
      "items": false
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "name", "predecessor", "paid", "budget_pool", "claim_eligible", "entry_requirements", "exit_requirements", "failure_disposition"],
      "properties": {
        "phase_id": { "pattern": "^P[0-6]$" },
        "name": { "type": "string", "minLength": 3 },
        "predecessor": { "type": ["string", "null"], "pattern": "^P[0-6]$" },
        "paid": { "type": "boolean" },
        "budget_pool": { "enum": ["none", "api_testing", "benchmark"] },
        "claim_eligible": { "type": "boolean" },
        "entry_requirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "exit_requirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "failure_disposition": { "enum": ["stop", "stop_descriptive_only", "publish_no_claim"] }
      }
    },
    "P0": { "allOf": [{ "$ref": "#/$defs/phase" }, { "properties": { "phase_id": { "const": "P0" }, "predecessor": { "type": "null" }, "paid": { "const": false }, "budget_pool": { "const": "none" }, "claim_eligible": { "const": false } } }] },
    "P1": { "allOf": [{ "$ref": "#/$defs/phase" }, { "properties": { "phase_id": { "const": "P1" }, "predecessor": { "const": "P0" }, "paid": { "const": false }, "budget_pool": { "const": "none" }, "claim_eligible": { "const": false } } }] },
    "P2": { "allOf": [{ "$ref": "#/$defs/phase" }, { "properties": { "phase_id": { "const": "P2" }, "predecessor": { "const": "P1" }, "paid": { "const": true }, "budget_pool": { "const": "api_testing" }, "claim_eligible": { "const": false } } }] },
    "P3": { "allOf": [{ "$ref": "#/$defs/phase" }, { "properties": { "phase_id": { "const": "P3" }, "predecessor": { "const": "P2" }, "paid": { "const": true }, "budget_pool": { "const": "benchmark" }, "claim_eligible": { "const": false } } }] },
    "P4": { "allOf": [{ "$ref": "#/$defs/phase" }, { "properties": { "phase_id": { "const": "P4" }, "predecessor": { "const": "P3" }, "paid": { "const": false }, "budget_pool": { "const": "none" }, "claim_eligible": { "const": false } } }] },
    "P5": { "allOf": [{ "$ref": "#/$defs/phase" }, { "properties": { "phase_id": { "const": "P5" }, "predecessor": { "const": "P4" }, "paid": { "const": true }, "budget_pool": { "const": "benchmark" }, "claim_eligible": { "const": false } } }] },
    "P6": { "allOf": [{ "$ref": "#/$defs/phase" }, { "properties": { "phase_id": { "const": "P6" }, "predecessor": { "const": "P5" }, "paid": { "const": false }, "budget_pool": { "const": "none" }, "claim_eligible": { "const": true } } }] }
  }
}
