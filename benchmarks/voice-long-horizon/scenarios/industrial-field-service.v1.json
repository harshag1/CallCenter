      ],
      "result": {
        "fields": [
          { "path": "work_order_id", "value": { "source": "world", "path": "work_order_id" } },
          { "path": "asset_id", "value": { "source": "world", "path": "asset_id" } },
          { "path": "site_code", "value": { "source": "world", "path": "site_code" } },
